[Unit]
Description=Update system Flatpaks (bifrost-htpc)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Stops flatpak noting that its exports directory is not in the search path.
Environment=XDG_DATA_DIRS=/var/lib/flatpak/exports/share:/usr/local/share:/usr/share
ExecStart=/usr/bin/flatpak update --system --noninteractive -y
ExecStart=/usr/bin/flatpak uninstall --system --unused --noninteractive -y
