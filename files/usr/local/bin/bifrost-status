#!/usr/bin/bash
# Show what this box is running and how its updates are doing. Handy over SSH.
set -uo pipefail

section() { printf '\n== %s\n' "$*"; }

section "OS"
if [[ -e /run/ostree-booted ]]; then
    rpm-ostree status --json | jq -r '
        .deployments[] |
        "\(if .booted then "booted " elif .staged then "staged " else "       " end) \(.version // "?")  layered: \((.["requested-packages"] // []) | join(" ") | if . == "" then "none" else . end)"'
else
    echo "not a booted Kinoite system"
fi

section "Video"
if rpm -q ffmpeg >/dev/null 2>&1; then
    echo "FFmpeg: RPM Fusion's full one (plays H.264)"
else
    echo "FFmpeg: Fedora's (no H.264: Dropout and Twitch won't play)"
fi
if command -v vainfo >/dev/null; then
    va=$(vainfo --display drm 2>/dev/null)
    echo "Video driver: $(sed -n 's/.*Driver version: //p' <<<"$va" | head -n1 | grep . || echo none)"
    for codec in H264 HEVC VP9 AV1; do
        grep -q "VAProfile$codec.*VAEntrypointVLD" <<<"$va" && hw=yes || hw=no
        printf 'Hardware decoding %-5s %s\n' "$codec:" "$hw"
    done
fi

section "Timers"
for t in rpm-ostreed-automatic bifrost-flatpak-update bifrost-update-moonfin bifrost-update-dropout bifrost-upgrade-fedora bifrost-weekly-reboot; do
    next=$(systemctl show -p NextElapseUSecRealtime --value "$t.timer" 2>/dev/null)
    result=$(systemctl show -p Result --value "$t.service" 2>/dev/null)
    last=$(systemctl show -p ExecMainExitTimestamp --value "$t.service" 2>/dev/null)
    [[ -z $last ]] && result="-"
    printf '%-24s enabled: %-8s last run: %-28s result: %-8s next: %s\n' "$t" \
        "$(systemctl is-enabled "$t.timer" 2>/dev/null)" "${last:-never}" "${result:-?}" "${next:-?}"
done

section "Apps"
echo "Moonfin release: $(cat /var/lib/bifrost/moonfin-release 2>/dev/null || echo 'not installed')"
jq -r '.policies.ExtensionSettings | to_entries[] | "\(.key): \(.value.install_url)"' \
    /etc/firefox/policies/policies.json 2>/dev/null || echo "no Firefox policy"
flatpak list --system --app --columns=application,version

section "Last setup run"
grep '^=====' /var/log/bifrost-setup.log 2>/dev/null | tail -n1 || echo "none logged"
