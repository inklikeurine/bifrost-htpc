#!/usr/bin/bash
# Install Moonfin from its latest GitHub release, or update it if a newer one is out.
# Moonfin's .flatpak bundle has no update source, so Flatpak can't update it itself.
set -euo pipefail

app_id=org.moonfin.linux
repo=Moonfin-Client/Moonfin-Core
state=/var/lib/bifrost/moonfin-release

# Progress bars on a terminal; quiet under systemd.
if [[ -t 1 ]]; then
    curl_progress=(--progress-bar)
    flatpak_opts=(--system -y)
else
    curl_progress=(-sS)
    flatpak_opts=(--system -y --noninteractive)
fi

release=$(curl -fsSL --retry 3 "https://api.github.com/repos/$repo/releases/latest")
tag=$(jq -r .tag_name <<<"$release")
asset=$(jq -c '[.assets[] | select(.name | test("^Moonfin_Linux_v.*\\.flatpak$"))][0] // empty' <<<"$release")
url=$(jq -r '.browser_download_url // empty' <<<"$asset")
# GitHub publishes each asset's checksum as "sha256:<hex>".
sha256=$(jq -r '.digest // empty | ltrimstr("sha256:")' <<<"$asset")
size_mb=$(jq -r '(.size // 0) / 1048576 | floor' <<<"$asset")
if [[ -z $url ]]; then
    echo "Moonfin $tag has no x86_64 .flatpak asset; leaving the installed version alone." >&2
    exit 1
fi

if flatpak info --system "$app_id" >/dev/null 2>&1 && [[ $(cat "$state" 2>/dev/null) == "$tag" ]]; then
    echo "Moonfin $tag is already installed."
    exit 0
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
echo "Downloading Moonfin $tag ($size_mb MB) from $url"
download() {
    curl -fL "${curl_progress[@]}" --retry 3 -o "$tmp/moonfin.flatpak" "$url" || return 1
    [[ -z $sha256 ]] || sha256sum --quiet -c <<<"$sha256  $tmp/moonfin.flatpak"
}
download || { echo "Download failed or didn't match its checksum; retrying."; download; }
# --reinstall replaces the old version in place. App data in ~/.var/app (settings,
# server login) isn't touched.
echo "Installing Moonfin $tag"
install_bundle() { flatpak install "${flatpak_opts[@]}" --reinstall --bundle "$tmp/moonfin.flatpak"; }
# Pulling the runtime from Flathub in the same step has failed once with "Data is
# corrupt" and then worked on the next try, so try twice.
install_bundle || { echo "Retrying in 30 s..."; sleep 30; install_bundle; }
flatpak info --system "$app_id" >/dev/null

mkdir -p "$(dirname "$state")"
echo "$tag" >"$state"
echo "Moonfin $tag installed."
